{
  "name": "lemonroad",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "dev:stack": "bash scripts/dev-stack.sh",
    "setup:local": "bash scripts/bootstrap-local.sh",
    "setup:neon": "bash scripts/migrate-neon.sh",
    "setup:vercel-db": "bash scripts/set-vercel-database-env.sh",
    "vercel:link": "bash scripts/vercel-link-lemonroad.sh",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh",
    "deploy:mainnet:wait": "bash scripts/wait-and-deploy-mainnet.sh",
    "patch:env-mainnet": "bash scripts/patch-env-mainnet.sh",
    "sync:vercel-paid": "bash scripts/sync-vercel-paid-env.sh",
    "sync:vercel-push": "bash scripts/sync-vercel-push-env.sh",
    "init:pool": "ts-node --project tsconfig.api.json scripts/init-pool.ts",
    "build": "prisma generate && tsc -b && vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "backfill:degen-payout-players": "ts-node --project tsconfig.api.json scripts/backfill-degen-payout-players.ts",
    "test:top-lemons": "ts-node --project tsconfig.api.json scripts/test-top-lemons-board.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@metamask/connect-evm": "^1.3.1",
    "@prisma/client": "^6.2.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "0.15.20",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.100.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/node": "^5.8.3",
    "bs58": "^6.0.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.50.4",
    "wagmi": "^3.6.15",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "overrides": {
    "uuid": "8.3.2",
    "@solana/wallet-adapter-react": "0.15.20"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "prisma": "^6.2.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vercel": "^54.4.1",
    "vite": "^8.0.14",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
