# Copy to .env and fill in values. Never commit .env.

# --- Database (required) ---
# Runtime (Vercel/serverless): use the provider POOLED URL (Neon pooler, Supabase transaction pooler, etc.)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# Migrations / Prisma CLI only: direct (non-pooled) URL when your host provides one
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"
IP_HASH_SALT="generate-with-openssl-rand-hex-32"

# --- Session / cron / admin ---
CRON_SECRET="generate-random-secret"
ADMIN_PASSWORD="local-only"

# --- Solana paid mode (pick ONE payment backend) ---
# Option A: Anchor program (recommended — run scripts/deploy-mainnet.sh for production)
PROGRAM_ID=""
VITE_PROGRAM_ID=""

# Option B: Simple USDT transfer to a vault wallet (no on-chain program)
POOL_VAULT_OWNER=""

# SPL USDT mint (6 decimals) — mainnet USDT; must match on server and frontend build
USDT_MINT="Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"
VITE_USDT_MINT="Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"

# RPC / cluster — use a paid RPC (Helius/QuickNode) in production
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
VITE_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
VITE_SOLANA_CLUSTER="mainnet-beta"

# Settlement crank (server secret — Sensitive in Vercel; fund with mainnet SOL)
CRANK_KEYPAIR=""

# --- EVM paid mode (Polygon 137 or Ethereum 1; Amoy 80002 for local test only) ---
POOL_EVM_VAULT=""
EVM_CHAIN_ID="137"
EVM_RPC_URL=""
VITE_EVM_CHAIN_ID="137"
VITE_EVM_VAULT_ADDRESS=""
# Optional per-chain RPC overrides when MetaMask supports both Polygon + Ethereum
VITE_EVM_RPC_URL_POLYGON=""
VITE_EVM_RPC_URL_ETHEREUM=""

# --- Frontend ---
VITE_API_BASE=""
VITE_SITE_URL="https://www.lemonroad.xyz"
VITE_VAPID_PUBLIC_KEY=""

# --- Push (server) — generate: npx web-push generate-vapid-keys ---
# Copy public key to VITE_VAPID_PUBLIC_KEY. Sync to Vercel: npm run sync:vercel-push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@lemonroad.xyz"
