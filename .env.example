# Copy to .env and fill in values. Never commit .env.

# --- Database (required) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
IP_HASH_SALT="generate-with-openssl-rand-hex-32"

# --- Session / cron / admin ---
CRON_SECRET="generate-random-secret"
ADMIN_PASSWORD="local-only"

# --- Solana paid mode (pick ONE payment backend) ---
# Option A: Anchor program (recommended after deploy-devnet.sh)
PROGRAM_ID=""
VITE_PROGRAM_ID=""

# Option B: Simple USDT transfer to a vault wallet (no on-chain program)
# Wallet pubkey that owns the pool USDT token account (server only; no VITE_ prefix needed)
POOL_VAULT_OWNER=""

# SPL USDT mint (6 decimals) — must match on server and frontend build
USDT_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPEPpGqyejCcJxw4H"
VITE_USDT_MINT="4zMMC9srt5Ri5X14GAgXhaHii3GnPEPpGqyejCcJxw4H"

# RPC / cluster (server verifies txs; VITE_* baked into frontend at build)
SOLANA_RPC_URL="https://api.devnet.solana.com"
VITE_SOLANA_RPC_URL="https://api.devnet.solana.com"
VITE_SOLANA_CLUSTER="devnet"

# Settlement crank (server secret — Sensitive in Vercel)
CRANK_KEYPAIR=""

# --- EVM paid mode (Polygon Amoy testnet) ---
POOL_EVM_VAULT=""
EVM_CHAIN_ID="80002"
EVM_RPC_URL=""
VITE_EVM_CHAIN_ID="80002"
VITE_EVM_VAULT_ADDRESS=""

# --- Frontend ---
VITE_API_BASE=""
VITE_SITE_URL="http://localhost:5173"
VITE_VAPID_PUBLIC_KEY=""

# --- Push (server) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@lemonroad.xyz"
