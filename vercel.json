{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/how-to-play",       "destination": "/how-to-play.html" },
    { "source": "/daily-rewards",     "destination": "/daily-rewards.html" },
    { "source": "/leaderboard",       "destination": "/leaderboard.html" },
    { "source": "/faq",               "destination": "/faq.html" },
    { "source": "/reward-rules",      "destination": "/reward-rules.html" },
    { "source": "/play-to-burn",      "destination": "/play-to-burn.html" },
    { "source": "/free-browser-game", "destination": "/free-browser-game.html" },
    { "source": "/about",             "destination": "/about.html" },
    { "source": "/press",             "destination": "/press.html" },
    { "source": "/fair-play",         "destination": "/fair-play.html" },
    { "source": "/terms",             "destination": "/terms.html" },
    { "source": "/privacy",           "destination": "/privacy.html" },
    { "source": "/install/iphone",    "destination": "/install-iphone.html" },
    { "source": "/install/android",   "destination": "/install-android.html" },
    { "source": "/install",           "destination": "/install.html" },
    { "source": "/notifications",     "destination": "/notifications.html" },
    { "source": "/admin",             "destination": "/index.html" },
    { "source": "/admin/:path*",      "destination": "/index.html" },
    { "source": "/((?!api/)[^.]*)",    "destination": "/index.html" }
  ]
}
