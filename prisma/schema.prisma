generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DailyRewardStatus {
  PENDING
  PAID
  REJECTED
}

enum DailyLeaderboardStatus {
  PENDING
  AWARDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

model Player {
  id                String             @id @default(uuid())
  sessionId         String             @unique @map("session_id")
  ipHash            String             @map("ip_hash")
  walletPubkey      String?            @unique @map("wallet_pubkey")
  displayName       String             @default("Anonymous Lemon") @map("display_name")
  /** Lifetime Lemon XP from valid runs (distance ÷ 50); used for level display. */
  lemonXp           Int                @default(0) @map("lemon_xp")
  referralCode      String?            @unique @map("referral_code")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  runs              GameRun[]
  dailyEntries      DailyLeaderboard[]
  dailyRewards      DailyReward[]
  pushSubscriptions PushSubscription[]
  referralsMade     Referral[]         @relation("Referrer")
  referralReceived  Referral?          @relation("Referee")

  @@index([ipHash])
  @@map("players")
}

model GameRun {
  id             String   @id @default(uuid())
  playerId       String   @map("player_id")
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  mode           String
  distance       Float
  juiceLevel     String   @map("juice_level")
  citricVelocity Float    @map("citric_velocity")
  durationMs     Int      @map("duration_ms")
  diedAt         DateTime @default(now()) @map("died_at")
  depositTx      String?  @map("deposit_tx")
  hourBucket     String?  @map("hour_bucket")
  dayBucket      String?  @map("day_bucket")
  walletPubkey   String?  @map("wallet_pubkey")
  deviceType     String?  @map("device_type")
  antiCheatScore Int      @default(0) @map("anti_cheat_score")
  isValid        Boolean  @default(true) @map("is_valid")
  referralQualified Referral?

  @@index([playerId, diedAt(sort: Desc)])
  @@index([mode, hourBucket, distance(sort: Desc)])
  @@index([mode, dayBucket, distance(sort: Desc)])
  @@index([depositTx])
  @@map("game_runs")
}

model DailyLeaderboard {
  id           String                 @id @default(uuid())
  date         DateTime               @db.Date
  playerId     String                 @map("player_id")
  player       Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  bestDistance Float                  @map("best_distance")
  totalRuns    Int                    @default(1) @map("total_runs")
  position     Int?
  rewardStatus DailyLeaderboardStatus @default(PENDING) @map("reward_status")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@unique([date, playerId])
  @@index([date, bestDistance(sort: Desc)])
  @@index([date, position])
  @@map("daily_leaderboard")
}

model DailyReward {
  id             String            @id @default(uuid())
  date           DateTime          @db.Date
  playerId       String            @map("player_id")
  player         Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position       Int
  rewardAmount   String            @map("reward_amount")
  rewardCurrency String            @map("reward_currency")
  status         DailyRewardStatus @default(PENDING)
  txHash         String?           @map("tx_hash")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([date, playerId])
  @@index([date, status])
  @@map("daily_rewards")
}

model PushSubscription {
  id         String   @id @default(uuid())
  playerId   String   @map("player_id")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([playerId, enabled])
  @@map("push_subscriptions")
}

model HourlyPool {
  hourStart        DateTime @id @map("hour_start")
  participantCount Int      @default(0) @map("participant_count")
  depositedUsdt    BigInt   @default(0) @map("deposited_usdt")
  rolloverIn       BigInt   @default(0) @map("rollover_in")
  rolloverOut      BigInt   @default(0) @map("rollover_out")
  settledAt        DateTime? @map("settled_at")
  settleTx         String?  @map("settle_tx")
  payouts          PrizePayout[]

  @@map("hourly_pools")
}

model PrizePayout {
  id            String     @id @default(uuid())
  hourStart     DateTime   @map("hour_start")
  hour          HourlyPool @relation(fields: [hourStart], references: [hourStart], onDelete: Cascade)
  place         Int
  walletPubkey  String     @map("wallet_pubkey")
  amountUsdt    BigInt     @map("amount_usdt")
  txSignature   String?    @map("tx_signature")

  @@unique([hourStart, place])
  @@map("prize_payouts")
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String         @map("referrer_id")
  referrer       Player         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId      String         @unique @map("referee_id")
  referee        Player         @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  code           String
  status         ReferralStatus @default(PENDING)
  rejectReason   String?        @map("reject_reason")
  refereeIpHash  String         @map("referee_ip_hash")
  qualifiedRunId String?        @unique @map("qualified_run_id")
  qualifiedRun   GameRun?       @relation(fields: [qualifiedRunId], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")
  qualifiedAt    DateTime?      @map("qualified_at")

  @@index([referrerId, status])
  @@map("referrals")
}

model VerifiedDeposit {
  txSignature  String    @id @map("tx_signature")
  walletPubkey String    @map("wallet_pubkey")
  hourBucket   String    @map("hour_bucket")
  amountUsdt   BigInt    @map("amount_usdt")
  paymentChain String    @default("solana") @map("payment_chain")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([walletPubkey, hourBucket, usedAt])
  @@map("verified_deposits")
}
